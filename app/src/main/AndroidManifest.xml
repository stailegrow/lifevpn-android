<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Сканер QR в диалоге добавления сервера (ui/components/QrScannerView.kt).
         Камера не обязательна для самого приложения — без неё остаются
         рабочими режимы "Ссылки" и "Подписка", поэтому required="false". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Обновления приложения качаются и ставятся прямо из него (см.
         core/UpdateChecker.kt) — своего магазина у Life VPN нет, только
         GitHub Releases. Для показа системного установщика на скачанный
         APK нужно это разрешение (Android 8+; на более старых версиях
         роль играет общий тумблер "Неизвестные источники"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Нужно на Android 11+ (API 30+), чтобы queryIntentActivities в
         AppPickerDialog вообще видел чужие приложения для раздельного
         туннелирования — без этого блока список окажется пустым. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Иконка — из настоящего Resources/AppIcon.icns мак-проекта (adaptive + legacy, см. res/mipmap-*, res/drawable-xxxhdpi) -->
    <application
        android:name=".MaxStrikeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Сам туннель. BIND_VPN_SERVICE — обязательное системное
             требование для VpnService, foregroundServiceType специально
             под VPN (Android 14+ требует явный тип для foreground-сервисов). -->
        <service
            android:name=".vpn.MaxStrikeVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Плитка в шторке "Быстрые настройки" (VpnQuickTile.kt) - системный
             API TileService, доступен с API 24 (наш minSdk). exported=true и
             BIND_QUICK_SETTINGS_TILE - обязательные системные требования
             (иначе система не сможет привязаться к сервису из шторки), сам
             биндинг всё равно ограничен системным UI этим разрешением.
             Иконка тут - только дефолт на случай, если система запросит её
             до первого вызова onStartListening()/render(): в рабочем режиме
             VpnQuickTile.render() всегда переопределяет tile.icon явно
             (ic_tile_off/ic_tile_on - свой фирменный знак приложения, тот же
             силуэт, что на лаунчере, залитый зелёным цветом "good" именно
             когда VPN подключён). -->
        <service
            android:name=".vpn.VpnQuickTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_off"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider — единственный безопасный способ отдать
             системному установщику пакетов скачанный APK (обычный file://
             URI из чужого приложения запрещён StrictMode начиная с
             Android 7). Открывает наружу только app/src/main/res/xml/
             file_paths.xml -> папку кэша "updates/", куда UpdateChecker.kt
             кладёт файл. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
